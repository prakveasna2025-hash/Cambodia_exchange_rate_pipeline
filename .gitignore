-- Day: 3
---------------------

# ---------- Secrets ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/

# ---------- Testing / coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Data & databases ----------
# raw CSVs you don't want in git (uncomment if private or huge)
# data/raw/*.csv
data/processed/
*.parquet
*.db
*.sqlite
*.sqlite3

# ---------- Logs ----------
*.log
logs/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Docker ----------
# keep docker-compose.yml, ignore local overrides
docker-compose.override.yml
.docker/

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------- OS / editor cruft ----------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ---------- OneDrive temp files ----------
# OneDrive sometimes drops these into synced folders
*.tmp
~$*.xlsx
~$*.docx

